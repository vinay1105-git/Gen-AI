print("\n14. SECURITY VALIDATION")

def security_check(
    prompt,
    filename=None,
    file_size_mb=0
):

    injection_patterns = [
        "ignore previous instructions",
        "ignore all previous instructions",
        "reveal system prompt",
        "bypass security",
        "disable safety"
    ]

    if any(
        pattern in prompt.lower()
        for pattern in injection_patterns
    ):

        return "BLOCKED - Prompt injection detected"

    if filename:

        allowed_extensions = [
            ".png",
            ".jpg",
            ".jpeg",
            ".wav",
            ".mp3"
        ]

        extension = filename.lower().split(".")[-1]

        if "." + extension not in allowed_extensions:

            return "REJECTED - Unsupported file type"

    if file_size_mb > 10:

        return "REJECTED - File size exceeds limit"

    return "ACCEPTED"


