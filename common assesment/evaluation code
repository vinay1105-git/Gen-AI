# ============================================================
# 2. DOCUMENT PREPROCESSING AND CHUNKING
# ============================================================

chunks = []

for doc in documents:
    sentences = re.split(r"(?<=[.!?])\s+", doc["text"].strip())

    for i in range(0, len(sentences), 2):
        chunk = " ".join(sentences[i:i+2]).strip()

        if chunk:
            chunks.append({
                "Chunk ID": f'{doc["id"]}-C{(i//2)+1}',
                "Document ID": doc["id"],
                "Document": doc["title"],
                "Text": chunk
            })

chunks_df = pd.DataFrame(chunks)

print("\n2. DOCUMENT CHUNKS")
display(chunks_df)


