# ============================================================
# 8. AI AGENT - TOOL 2: CALCULATOR
# ============================================================

def calculator_tool(value, unit_from, unit_to):

    conversions = {
        ("inch", "cm"): 2.54,
        ("inches", "cm"): 2.54,
        ("cm", "inch"): 1 / 2.54,
        ("meter", "cm"): 100,
        ("m", "cm"): 100,
        ("cm", "m"): 0.01
    }

    key = (
        unit_from.lower(),
        unit_to.lower()
    )

    if key not in conversions:
        return "Conversion not supported"

    return round(
        value * conversions[key],
        3
    )


# ============================================================
# 9. AI AGENT DECISION POLICY
# ============================================================

def agent(query):

    q = query.lower()

    # Tool 1
    machine_match = re.search(
        r"\bm\d+\b",
        q
    )

    if "production" in q and machine_match:

        machine = machine_match.group().upper()

        return (
            "CSV Query Tool",
            csv_query_tool(machine)
        )

    # Tool 2
    conversion_match = re.search(
        r"(\d+(?:\.\d+)?)\s*(inch|inches|cm|m|meter)\s*(?:to|into)\s*(cm|inch|m)",
        q
    )

    if conversion_match:

        value = float(conversion_match.group(1))
        from_unit = conversion_match.group(2)
        to_unit = conversion_match.group(3)

        return (
            "Calculator / Unit Conversion Tool",
            calculator_tool(
                value,
                from_unit,
                to_unit
            )
        )

    # RAG tool
    if any(
        word in q
        for word in [
            "maintenance",
            "safety",
            "motor",
            "pump",
            "bearing",
            "vibration",
            "equipment"
        ]
    ):

        result = retrieve(query, 3)

        return (
            "RAG Retrieval Tool",
            result[
                ["Chunk ID", "Document", "Similarity"]
            ].to_dict("records")
        )

    return (
        "Clarification",
        "Please provide a specific engineering query."
    )


