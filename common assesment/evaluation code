# ============================================================
# 5. RAG TOP-3 RETRIEVAL
# ============================================================

def retrieve(query, k=3):

    query_embedding = model.encode(
        [query],
        normalize_embeddings=True,
        convert_to_numpy=True
    ).astype("float32")

    scores, ids = index.search(query_embedding, k)

    results = []

    for rank, (score, idx) in enumerate(
        zip(scores[0], ids[0]), start=1
    ):
        row = chunks_df.iloc[int(idx)]

        results.append([
            rank,
            row["Chunk ID"],
            row["Document"],
            round(float(score), 4),
            row["Text"]
        ])

    return pd.DataFrame(
        results,
        columns=[
            "Rank",
            "Chunk ID",
            "Document",
            "Similarity",
            "Retrieved Text"
        ]
    )


